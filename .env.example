# Copy to .env.local for local Next.js development. Never commit real values.
APP_ENV=local
APP_VERSION=0.1.0-dev
GIT_SHA=local
BUILD_TIME=1970-01-01T00:00:00.000Z
PUBLIC_APP_URL=http://127.0.0.1:3000
LOG_LEVEL=debug

# Public browser-safe values only.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_NAME=ProtoStack

# Optional in Milestone 1. The core landing page and health endpoint do not require Supabase.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-status

# Required only for staging/production access to /api/admin/build-info.
ADMIN_DIAGNOSTICS_TOKEN=replace-with-a-random-secret-outside-source-control
