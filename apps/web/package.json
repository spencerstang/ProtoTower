{
  "name": "@protostack/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next .open-next coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "upload:preview": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env preview",
    "upload:staging": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env staging",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@protostack/configuration": "workspace:*",
    "@protostack/protocol-engine": "workspace:*",
    "@protostack/ui": "workspace:*",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.19.11",
    "wrangler": "4.114.0"
  }
}
